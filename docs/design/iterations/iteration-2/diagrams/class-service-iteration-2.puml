@startuml
title 服务、会话与权限类图 — Iteration 2（最终）
skinparam classAttributeIconSize 0
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 11
skinparam wrapWidth 170
skinparam nodesep 30
skinparam ranksep 40
hide empty members
hide circle
left to right direction

package "service" {
  class Session {
    - currentUser: Employee
    + login(Employee): void
    + logout(): void
    + currentUser(): Optional<Employee>
    + isAdmin(): boolean
    + isTeacher(): boolean
    + requireAdmin(): void
    + requireTeacher(): void
    + teacherId(): Long
    + canAccess(ClassCourse): boolean
    + filterClassCourses(List<ClassCourse>): List<ClassCourse>
  }

  class AuthService {
    + login(String, String): Employee
    + logout(): void
    + changePassword(String, String): void
    + currentUser(): Optional<Employee>
    + session(): Session
  }

  class DepartmentService {
    + list(): List<Department>
    + search(String): List<Department>
    + create(String, String): Department
    + update(long, String, String): void
    + delete(long): void
    + employeeCount(long): long
  }

  class EmployeeService {
    + search(String, Long, Role, EmployeeStatus): List<Employee>
    + create(String, String, String, Gender, String, String, long, Role, LocalDate): Employee
    + update(long, String, String, Gender, String, String, long, Role): void
    + delete(long): void
    + changeStatus(long, EmployeeStatus): void
    + changeRole(long, Role): void
    + resetPassword(long, String): void
    + findById(long): Employee
    + listTeachers(): List<Employee>
  }

  class CourseService {
    + list(): List<Course>
    + create(String, String, String): Course
    + update(long, String, String, String): void
    + delete(long): void
  }

  class ClassService {
    + list(): List<SchoolClass>
    + filter(String, ClassStatus, Long): List<SchoolClass>
    + create(String, String, Long, LocalDate, LocalDate, int): SchoolClass
    + update(long, String, String, Long, LocalDate, LocalDate, int): void
    + delete(long): void
    + changeStatus(long, ClassStatus): void
    + assignHeadTeacher(long, Long): void
  }

  class TeachingService {
    + listByClass(long): List<ClassCourse>
    + addCourse(long, long): ClassCourse
    + assignTeacher(long, Long): void
    + removeCourse(long): void
    + listByTeacher(long): List<ClassCourse>
  }

  class StudentService {
    + list(): List<Student>
    + search(String, Long, StudentStatus): List<Student>
    + listByClass(long): List<Student>
    + create(String, String, Gender, String, long, LocalDate): Student
    + update(long, String, Gender, String): void
    + delete(long): void
    + transfer(long, long): void
    + changeStatus(long, StudentStatus): void
  }

  class ScoreService {
    + listByClassCourse(long): List<Score>
    + findByStudentAndCourse(long, long): Optional<Score>
    + record(long, long, double): Score
    + update(long, double): void
    + delete(long): void
    + batchRecord(long, Map<String,Double>): List<String>
  }

  class StatisticsService {
    + classStatistics(long): ClassStatistics
    + courseStatistics(long): CourseStatistics
    + studentStatistics(long): StudentStatistics
    + classRanking(long): List<RankEntry>
    + studentMetrics(long): StudentMetrics
  }

  class WarningService {
    + studentWarnings(long): List<WarningResult>
    + classWarning(long): ClassWarning
    + evaluateStudent(long): WarningResult
  }
}

package "persistence（契约）" {
  interface "Repository<T extends Identifiable>" as Repository {
    + findAll(): List<T>
    + findById(long): Optional<T>
    + save(T): T
    + delete(long): void
    + saveAll(): void
    + findAll(Predicate<T>): List<T>
    + findFirst(Predicate<T>): Optional<T>
  }
}

package "model（详见领域类图）" {
  class Employee
  class Student
  class Department
  class Course
  class SchoolClass
  class ClassCourse
  class Score
}

package "dto（详见 DTO 类图）" {
  class ClassStatistics
  class CourseStatistics
  class StudentStatistics
  class RankEntry
  class StudentMetrics
  class WarningResult
  class ClassWarning
}

package "util" {
  class PasswordHasher
}

' 会话与权限
AuthService --> Session
AuthService --> PasswordHasher
Session --> ClassCourse : canAccess / filter

' 仓储依赖：每个 service 只依赖 Repository<T> 接口
AuthService --> Repository : Employee
DepartmentService --> Repository : Department / Employee
EmployeeService --> Repository : Employee / Department / SchoolClass / ClassCourse
CourseService --> Repository : Course / ClassCourse / Score
ClassService --> Repository : SchoolClass / Employee / Student / ClassCourse / Score
TeachingService --> Repository : ClassCourse / SchoolClass / Course / Employee / Score
StudentService --> Repository : Student / SchoolClass / ClassCourse / Score
ScoreService --> Repository : Score / Student / ClassCourse / SchoolClass
StatisticsService --> Repository : Student / SchoolClass / ClassCourse / Score / Course / Employee
WarningService --> Repository : Student / SchoolClass / ClassCourse

' 权限依赖（D-01 / D-02 / D-03）
DepartmentService --> Session : requireAdmin
ClassService --> Session : requireAdmin
TeachingService --> Session : requireAdmin
EmployeeService --> Session
StudentService --> Session
ScoreService --> Session
StatisticsService --> Session
WarningService --> Session

WarningService --> StatisticsService : 复用指标计算

StatisticsService ..> ClassStatistics
StatisticsService ..> CourseStatistics
StatisticsService ..> StudentStatistics
StatisticsService ..> RankEntry
StatisticsService ..> StudentMetrics
WarningService ..> WarningResult
WarningService ..> ClassWarning

note right of Repository
  service 只依赖 Repository<T> 接口；
  具体 CsvRepository<T> 由
  ApplicationBootstrap 注入。
end note

note bottom of StatisticsService
  按 Session 的可见范围聚合成绩；
  转班学生的旧成绩仍在原 ClassCourse。
end note

note bottom of WarningService
  评估 R1–R6 并收集全部命中规则，
  取最高等级；无可见成绩为“数据不足”。
  除 StatisticsService 与 Session 外，
  还直接依赖 3 个仓储（D-02）。
end note

note right of ScoreService
  唯一键 (studentId, courseId)：
  由 classCourseId 解析 courseId；
  已有成绩则更新原记录，
  不因转班产生重复成绩。
end note

note bottom of CourseService
  list() 供 UC-06a 使用；
  教师只读，增删改由
  requireAdmin() 校验。
end note

note bottom of Session
  权限判断的唯一入口：
  控制器不再自行比较角色，
  一律通过 requireAdmin / canAccess。
end note

@enduml
