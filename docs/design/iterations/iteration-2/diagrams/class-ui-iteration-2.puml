@startuml
title CUI 菜单与界面类图 — Iteration 2（最终）
skinparam classAttributeIconSize 0
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 11
skinparam wrapWidth 170
skinparam nodesep 26
skinparam ranksep 36
hide empty members
hide circle
left to right direction

package "ui.menu" {
  interface MenuAction {
    + execute(): void
  }
  class MenuItem {
    - key: String
    - label: String
    - action: MenuAction
    + matches(String): boolean
    + execute(): void
    + getKey(): String
    + getLabel(): String
  }
  class Menu {
    - title: String
    - items: List<MenuItem>
    + setZeroLabel(String): void
    + addItem(String, String, MenuAction): void
    + run(ConsoleIO): void
    - display(): void
  }
}

package "ui" {
  class ConsoleIO {
    + readLine(String): String
    + readCommand(String): String
    + readPassword(String): String
    + readInt(String, int, int): int
    + readDouble(String, double, double): double
    + readRequired(String, String): String
    + confirm(String): boolean
    + print(String): void
    + println(String): void
    + println(): void
  }
  class TablePrinter {
    + printTable(List<String[]>, String[]): void
    + showPaged(List<String[]>, String[], ConsoleIO): void
    + page(List<T>, int, int): List<T>
    + pageCount(int, int): int
  }
  interface MenuFactory {
    + createMenu(Session): Menu
  }
  class AdminMenuFactory implements MenuFactory {
    + createMenu(Session): Menu
  }
  class TeacherMenuFactory implements MenuFactory {
    + createMenu(Session): Menu
  }
  class LoginUI {
    + run(): void
  }
}

package "ui.view" {
  class DepartmentUI {
    + show(): void
  }
  class EmployeeUI {
    + show(): void
  }
  class CourseUI {
    + show(): void
  }
  class ClassUI {
    + show(): void
  }
  class TeachingUI {
    + show(): void
  }
  class StudentUI {
    + show(): void
  }
  class ScoreUI {
    + show(): void
  }
  class StatisticsUI {
    + show(): void
    + showClassStatistics(): void
    + showStudentStatistics(): void
  }
  class WarningUI {
    + show(): void
  }
  class AccountUI {
    + show(): void
    + showProfile(): void
  }
  class UiSupport {
    + parseGender(String, Gender): Gender
    + parseRole(String): Role
    + parseEmployeeStatus(String): EmployeeStatus
    + parseStudentStatus(String): StudentStatus
    + parseClassStatus(String): ClassStatus
    + readId(ConsoleIO, String, String): Long
    + text(String): String
    + formatScore(Double): String
    + formatRate(Double): String
    + levelText(WarningLevel): String
    + classLevelText(ClassWarningLevel): String
    + parseLevelFilter(String): String
  }
}

package "service（详见服务类图）" {
  class AuthService
  class DepartmentService
  class EmployeeService
  class CourseService
  class ClassService
  class TeachingService
  class StudentService
  class ScoreService
  class StatisticsService
  class WarningService
  class Session
}

